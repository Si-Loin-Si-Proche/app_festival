{
  "name": "siloinsiproche",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "---------- COMMANDES DE BASE ----------": "",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "---------- MAINTENANCE ----------": "",
    "clean": "rimraf node_modules .expo package-lock.json && npm install",
    "reset": "npx expo start --clear",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "compile": "eas build --platform android --profile preview",
    "check-plugins": "npx expo install --check",
    "update-safe": "npx expo install --fix",
    "release": "node release.js",
    "---------- GIT FACILE ----------": "",
    "save": "node easy-git.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dudigital/react-native-zoomable-view": "^1.1.4",
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "axios": "^1.13.2",
    "expo": "~54.0.34",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.556.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "react-native-svg-transformer": "^1.5.2",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npx eslint --fix --no-warn-ignored",
      "npx prettier --write"
    ],
    "*.{json,md}": [
      "npx prettier --write"
    ]
  }
}
