{
  "name": "siloinsiproche",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "---------- COMMANDES DE BASE ----------": "",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "---------- MAINTENANCE ----------": "",
    "clean": "rimraf node_modules .expo package-lock.json && npm install",
    "reset": "npx expo start --clear",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "---------- GIT FACILE ----------": "",
    "save": "node easy-git.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "axios": "^1.13.2",
    "expo": "~54.0.27",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npx eslint --fix --no-warn-ignored",
      "npx prettier --write"
    ],
    "*.{json,md}": [
      "npx prettier --write"
    ]
  }
